-- ==========================================================================================
-- STEP 4: Add indexes and foreign keys in bulk AFTER all batches finish
-- ==========================================================================================
ALTER TABLE fact_inventory
    ADD FOREIGN KEY (inventory_key) REFERENCES dim_inventory(inventory_key),
    ADD FOREIGN KEY (ingestion_date_key) REFERENCES dim_date(date_key),
    ADD FOREIGN KEY (opened_by_staff_key) REFERENCES dim_staff(staff_key),
    ADD FOREIGN KEY (received_by_staff_key) REFERENCES dim_staff(staff_key),
    ADD FOREIGN KEY (issued_by_staff_key) REFERENCES dim_staff(staff_key),
    ADD FOREIGN KEY (closed_by_staff_key) REFERENCES dim_staff(staff_key),
    ADD FOREIGN KEY (verified_by_staff_key) REFERENCES dim_staff(staff_key),
    ADD INDEX fact_inventory_ix_1 (inventory_key),
    ADD INDEX fact_inventory_ix_2 (ingestion_date_key),
    ADD INDEX fact_inventory_ix_3 (received_by_staff_key);

-- ==========================================================================================
-- STEP 5: Validation
-- ==========================================================================================
SELECT check_name, found, expected,
       IF(found = expected, 'PASS', 'FAIL') AS result
FROM (
    SELECT 'fact_inventory rows = stg_inventory rows' AS check_name,
           (SELECT COUNT(*) FROM fact_inventory) AS found,
           (SELECT COUNT(*) FROM stg_inventory) AS expected
) t;
